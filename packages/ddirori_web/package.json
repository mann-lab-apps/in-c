    "verify:studio": "node catalog/studio/verify-browser.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.9",
    "jsdom": "^29.1.1",
    "@testing-library/react": "^16.3.2",
    "lucide-react": "^1.21.0",
    "vexflow": "^5.0.0"
  }
}
