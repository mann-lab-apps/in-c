{
  "name": "@ddirori/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8058",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "dev:studio": "vite --config studio.config.ts --host 127.0.0.1 --port 8062 --strictPort",
