{
  "schemaVersion": "1.1",
  "brandInput": "palette-pilot.json",
  "themes": {
    "light": {
      "background": "@light.background",
      "surface": "@light.surface",
      "surfaceMuted": "@light.surfaceMuted",
      "text": "@light.ink",
      "muted": "@light.muted",
      "action": "@light.primary",
      "actionHover": "@light.primaryHover",
      "actionPressed": "@light.primaryPressed",
      "onAction": "@light.onPrimary",
      "sky": "@light.sky",
      "peach": "@light.peach",
      "onPastel": "@light.ink",
      "border": "@light.border",
      "controlBorder": "@light.controlBorder",
      "focus": "@light.primary",
      "success": "@light.success",
      "warning": "@light.warning",
      "error": "@light.error",
      "disabled": "#E5E5E5",
      "onDisabled": "#616161",
      "overlay": "#202020",
      "onOverlay": "#FFFFFF",
      "brand": "@brand.primary",
      "onBrand": "@brand.onPrimary",
      "selection": "@light.tint",
      "onSelection": "@light.ink",
      "info": "@light.muted",
      "interactionHover": "@light.surfaceMuted",
      "interactionPressed": "#E5E5E5"
    },
    "dark": {
      "background": "@darkProposal.background",
      "surface": "@darkProposal.surface",
      "surfaceMuted": "@darkProposal.surfaceMuted",
      "text": "@darkProposal.ink",
      "muted": "@darkProposal.muted",
      "action": "@darkProposal.primary",
      "actionHover": "@darkProposal.primaryHover",
      "actionPressed": "@darkProposal.primaryPressed",
      "onAction": "@darkProposal.onPrimary",
      "sky": "@darkProposal.sky",
      "peach": "@darkProposal.peach",
      "onPastel": "@light.ink",
      "border": "@darkProposal.border",
      "controlBorder": "@darkProposal.controlBorder",
      "focus": "@darkProposal.primary",
      "success": "#7DD8AD",
      "warning": "#F1CD88",
      "error": "#FFADB6",
      "disabled": "#383838",
      "onDisabled": "#B8B8B8",
      "overlay": "#202020",
      "onOverlay": "#FFFFFF",
      "brand": "@brand.primary",
      "onBrand": "@brand.onPrimary",
      "selection": "@darkProposal.tint",
      "onSelection": "@darkProposal.ink",
      "info": "@darkProposal.muted",
      "interactionHover": "@darkProposal.surfaceMuted",
      "interactionPressed": "#383838"
    }
  },
  "score": {
    "paper": "@scorePaper.background",
    "notation": "@scorePaper.notation",
    "annotationInk": "#111111",
    "annotationRed": "#D33232",
    "annotationBlue": "#1D5FD1",
    "annotationYellow": "#FFCC25",
    "voiceOne": "#1D5FD1",
    "voiceTwo": "#9358B7",
    "playhead": "#19734D"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "control": 10,
    "card": 12,
    "panel": 16,
    "pill": 999
  },
  "density": {
    "comfortable": {
      "control": 48,
      "gap": 12,
      "font": 16
    },
    "compact": {
      "control": 32,
      "gap": 8,
      "font": 14
    }
  },
  "typography": {
    "body": 16,
    "label": 14,
    "title": 24,
    "display": 32,
    "lineHeight": 1.5,
    "webFamily": "\"Ddirori Pretendard\", system-ui, sans-serif",
    "flutterFamily": "platform default; optional licensed TTF/OTF supplied by consumer",
    "caption": 12,
    "section": 20,
    "headingLineHeight": 1.3,
    "controlLineHeight": 1.4,
    "bodyWeight": 400,
    "labelWeight": 500,
    "actionWeight": 600,
    "headingWeight": 700,
    "headingTracking": -0.02
  },
  "motion": {
    "feedbackMs": 120,
    "panelMs": 180,
    "loaderCycleMs": 1200
  },
  "contentInput": "color-system.json",
  "control": {
    "choiceHeight": 36,
    "choiceCompactHeight": 32,
    "choicePaddingX": "$spacing.md",
    "choicePaddingY": 7,
    "choiceCompactPaddingY": 5,
    "choiceGap": 6,
    "choiceIcon": 14,
    "buttonPaddingX": "$spacing.lg",
    "buttonPaddingY": 10,
    "fieldGap": 6,
    "focusWidth": 2,
    "focusOffset": 2,
    "borderWidth": 1,
    "toolRadius": 8,
    "touchTarget": 48,
    "fieldPadding": 14,
    "iconPadding": "$spacing.sm"
  },
  "layout": {
    "pageGutter": "$spacing.lg",
    "pageGutterWide": "$spacing.xxl",
    "sectionGap": "$spacing.xl",
    "sectionGapWide": "$spacing.xxl",
    "rowPadding": "$spacing.lg",
    "itemGap": "$spacing.md",
    "labelGap": 6,
    "panelWidth": 280,
    "panelMin": 240,
    "dialogWidth": 560,
    "sheetWidth": 720,
    "contentMax": 1120,
    "dialogPadding": "$spacing.xl"
  },
  "breakpoints": {
    "medium": 600,
    "wide": 960,
    "workspace": 1280
  },
  "layer": {
    "base": 0,
    "sticky": 10,
    "popover": 20,
    "modal": 30,
    "notice": 40,
    "tooltip": 50
  },
  "elevation": {
    "flat": 0,
    "floating": 4,
    "modal": 8
  },
  "icon": {
    "small": 16,
    "tool": 18,
    "default": 20,
    "large": 24,
    "stroke": 1.75
  },
  "easing": {
    "standard": [
      0.2,
      0,
      0,
      1
    ],
    "exit": [
      0.4,
      0,
      1,
      1
    ]
  },
  "textStyles": {
    "screenTitle": {
      "size": "$typography.title",
      "weight": "$typography.headingWeight",
      "lineHeight": "$typography.headingLineHeight",
      "tracking": "$typography.headingTracking"
    },
    "sectionTitle": {
      "size": "$typography.section",
      "weight": "$typography.actionWeight",
      "lineHeight": "$typography.headingLineHeight",
      "tracking": "$typography.headingTracking"
    },
    "itemTitle": {
      "size": "$typography.body",
      "weight": "$typography.actionWeight",
      "lineHeight": "$typography.headingLineHeight",
      "tracking": 0
    },
    "body": {
      "size": "$typography.body",
      "weight": "$typography.bodyWeight",
      "lineHeight": "$typography.lineHeight",
      "tracking": 0
    },
    "description": {
      "size": "$typography.label",
      "weight": "$typography.bodyWeight",
      "lineHeight": "$typography.lineHeight",
      "tracking": 0
    },
    "label": {
      "size": "$typography.label",
      "weight": "$typography.labelWeight",
      "lineHeight": "$typography.controlLineHeight",
      "tracking": 0
    },
    "action": {
      "size": "$typography.body",
      "weight": "$typography.actionWeight",
      "lineHeight": "$typography.controlLineHeight",
      "tracking": 0
    },
    "caption": {
      "size": "$typography.caption",
      "weight": "$typography.labelWeight",
      "lineHeight": "$typography.controlLineHeight",
      "tracking": 0
    },
    "display": {
      "size": "$typography.display",
      "weight": "$typography.headingWeight",
      "lineHeight": "$typography.headingLineHeight",
      "tracking": "$typography.headingTracking"
    },
    "numeric": {
      "size": "$typography.body",
      "weight": "$typography.labelWeight",
      "lineHeight": "$typography.controlLineHeight",
      "tracking": 0
    }
  }
}
