{
  "schemaVersion": "1.0",
  "brandInput": "../ddirori-visuals/palette.json",
  "themes": {
    "light": {
      "background": "@light.background",
      "surface": "@light.surface",
      "surfaceMuted": "@light.tint",
      "text": "@light.ink",
      "muted": "@light.muted",
      "action": "@light.primary",
      "actionHover": "@light.primaryHover",
      "actionPressed": "@light.primaryPressed",
      "onAction": "@light.onPrimary",
      "sky": "@light.sky",
      "peach": "@light.peach",
      "onPastel": "@light.ink",
      "border": "@light.border",
      "controlBorder": "@light.controlBorder",
      "focus": "@light.primary",
      "success": "@light.success",
      "warning": "@light.warning",
      "error": "@light.error",
      "disabled": "#E2E9EF",
      "onDisabled": "#536B7A",
      "overlay": "#12232E",
      "onOverlay": "#FFFFFF"
    },
    "dark": {
      "background": "@darkProposal.background",
      "surface": "@darkProposal.surface",
      "surfaceMuted": "#233F51",
      "text": "@darkProposal.ink",
      "muted": "@darkProposal.muted",
      "action": "@darkProposal.primary",
      "actionHover": "#95CCF5",
      "actionPressed": "#B2DBFA",
      "onAction": "@darkProposal.onPrimary",
      "sky": "@darkProposal.sky",
      "peach": "@darkProposal.peach",
      "onPastel": "@light.ink",
      "border": "@darkProposal.border",
      "controlBorder": "#7691A3",
      "focus": "@darkProposal.primary",
      "success": "#7DD8AD",
      "warning": "#F1CD88",
      "error": "#FFADB6",
      "disabled": "#2A4353",
      "onDisabled": "#A6BCCC",
      "overlay": "#12232E",
      "onOverlay": "#FFFFFF"
    }
  },
  "score": {
    "paper": "@scorePaper.background",
    "notation": "@scorePaper.notation",
    "annotationInk": "#111111",
    "annotationRed": "#D33232",
    "annotationBlue": "#1D5FD1",
    "annotationYellow": "#FFCC25",
    "voiceOne": "#1D5FD1",
    "voiceTwo": "#9358B7",
    "playhead": "#19734D"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "control": 10,
    "card": 16,
    "panel": 20,
    "pill": 999
  },
  "density": {
    "comfortable": {
      "control": 48,
      "gap": 12,
      "font": 16
    },
    "compact": {
      "control": 32,
      "gap": 8,
      "font": 14
    }
  },
  "typography": {
    "body": 16,
    "label": 14,
    "title": 24,
    "display": 36,
    "lineHeight": 1.5,
    "webFamily": "\"Ddirori Pretendard\", system-ui, sans-serif",
    "flutterFamily": "platform default; optional licensed TTF/OTF supplied by consumer"
  },
  "motion": {
    "feedbackMs": 120,
    "panelMs": 180,
    "loaderCycleMs": 1200
  }
}
