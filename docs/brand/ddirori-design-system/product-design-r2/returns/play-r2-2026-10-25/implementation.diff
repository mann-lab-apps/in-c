+class _CountingPlayer extends FakeLocalPlayer {
+  _CountingPlayer()
+    : super(
+        trackDurations: {
+          for (final item in _queueA) item.trackId: const Duration(minutes: 3),
+        },
+      );
+  final commands = <String>[];
+  @override
+  Future<void> loadQueue(List<LocalPlaybackQueueItem> queue) {
+    commands.add('load');
+    return super.loadQueue(queue);
+  }
+
+  @override
+  Future<void> play() {
+    commands.add('play');
+    return super.play();
+  }
+
+  @override
+  Future<void> pause() {
+    commands.add('pause');
+    return super.pause();
+  }
+
+  @override
+  Future<void> resume() {
+    commands.add('resume');
+    return super.resume();
+  }
+
+  @override
+  Future<void> next() {
+    commands.add('next');
+    return super.next();
+  }
+
+  @override
+  Future<void> stop() {
+    commands.add('stop');
+    return super.stop();
+  }
+
+  @override
+  Future<void> seek(Duration position) {
+    commands.add('seek');
+    return super.seek(position);
+  }
+}
+
+class _HeldSeekPlayer extends _CountingPlayer {
+  final seekDone = Completer<void>();
+  var seekCalls = 0;
+  @override
+  Future<void> seek(Duration position) async {
+    seekCalls++;
+    await seekDone.future;
+    await super.seek(position);
+  }
+}
+
+class _RecoveringPlayer extends _CountingPlayer {
+  bool _failed = true;
+  @override
+  LocalPlaybackState get playbackState => _failed
+      ? LocalPlaybackState(
+          playerState: LocalPlayerState.error,
+          queue: _queueA,
+          currentIndex: 2,
+          position: const Duration(seconds: 42),
+          failure: const LocalPlaybackFailure(
+            kind: LocalPlaybackFailureKind.loadFailed,
+            userMessage: '오디오를 불러오지 못했습니다.',
+          ),
+        )
+      : super.playbackState;
+  @override
+  Future<void> loadQueue(List<LocalPlaybackQueueItem> queue) {
+    _failed = false;
+    return super.loadQueue(queue);
+  }
+}
