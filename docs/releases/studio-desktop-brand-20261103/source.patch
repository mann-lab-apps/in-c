diff --git a/scripts/build-studio-icons.mjs b/scripts/build-studio-icons.mjs
new file mode 100644
index 00000000..3f8783fd
--- /dev/null
+++ b/scripts/build-studio-icons.mjs
@@ -0,0 +1,34 @@
+// Renderer-only tooling, kept outside application dependencies.
+// npm install --prefix out/brand-tools --no-save --package-lock=false @resvg/resvg-js@2.6.2
+import { createRequire } from 'node:module'
+import { readFileSync, writeFileSync, mkdirSync, mkdtempSync, rmSync } from 'node:fs'
+import { resolve, join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { execFileSync } from 'node:child_process'
+import { createHash } from 'node:crypto'
+const root = resolve(import.meta.dirname, '..')
+const toolRoot = resolve(process.env.DDIRORI_ICON_TOOLS || join(root, 'out/brand-tools'))
+const require = createRequire(join(toolRoot, 'package.json'))
+const { Resvg } = require('@resvg/resvg-js')
+const version = require('@resvg/resvg-js/package.json').version
+if (version !== '2.6.2') throw Error('Use pinned @resvg/resvg-js 2.6.2')
+const svg = readFileSync(join(root, 'build/icon.svg'))
+const png = size => new Resvg(svg, { fitTo: {mode:'width',value:size} }).render().asPng()
+writeFileSync(join(root, 'build/icon.png'), png(1024))
+// Windows ICO contains standard PNG frames, including 256px for high DPI.
+const sizes=[16,24,32,48,64,128,256], frames=sizes.map(png)
+const header=Buffer.alloc(6+16*sizes.length); header.writeUInt16LE(1,2); header.writeUInt16LE(sizes.length,4)
+let offset=header.length
+frames.forEach((frame,i)=>{const at=6+16*i,size=sizes[i];header[at]=size===256?0:size;header[at+1]=header[at];header.writeUInt16LE(1,at+4);header.writeUInt16LE(32,at+6);header.writeUInt32LE(frame.length,at+8);header.writeUInt32LE(offset,at+12);offset+=frame.length})
+writeFileSync(join(root,'build/icon.ico'),Buffer.concat([header,...frames]))
+if(process.platform!=='darwin') throw Error('ICNS generation requires macOS iconutil; PNG/ICO rendered')
+const temporary=mkdtempSync(join(tmpdir(),'studio-icons-')),iconset=join(temporary,'Studio.iconset');mkdirSync(iconset)
+try{
+  for(const size of [16,32,128,256,512]){
+    writeFileSync(join(iconset,`icon_${size}x${size}.png`),png(size))
+    writeFileSync(join(iconset,`icon_${size}x${size}@2x.png`),png(size*2))
+  }
+  execFileSync('iconutil',['-c','icns',iconset,'-o',join(root,'build/icon.icns')])
+}finally{rmSync(temporary,{recursive:true,force:true})}
+const sha=p=>createHash('sha256').update(readFileSync(join(root,p))).digest('hex')
+console.log(JSON.stringify({source:'build/icon.svg',sourceSha256:sha('build/icon.svg'),renderer:`@resvg/resvg-js ${version}`,icns:'macOS iconutil',outputs:['build/icon.png','build/icon.ico','build/icon.icns'].map(path=>({path,sha256:sha(path)}))},null,2))
diff --git a/scripts/desktop-brand.test.mjs b/scripts/desktop-brand.test.mjs
new file mode 100644
index 00000000..4b18de6f
--- /dev/null
+++ b/scripts/desktop-brand.test.mjs
@@ -0,0 +1,37 @@
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+const pkg = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8'))
+it('brands visible packages without changing identity or version', () => {
+  expect(pkg.productName).toBe('띠로리 Studio')
+  expect(pkg.build.productName).toBe(pkg.productName)
+  expect(pkg.build.appId).toBe('com.mannlab.inc')
+  expect(pkg.name).toBe('in-c')
+  expect(pkg.desktopName).toBe('in-c.desktop')
+  expect(pkg.version).toBe('0.1.0-alpha.38')
+  expect(pkg.build.win.executableName).toBe('in-C')
+  expect(pkg.build.linux.executableName).toBe('in-c')
+  expect(pkg.build.mac.executableName).toBeUndefined()
+  expect(pkg.build.artifactName).toBe('Ddirori-Studio-${version}-${os}-${arch}.${ext}')
+})
+
+import { createRequire } from 'node:module'
+const require=createRequire(import.meta.url)
+const {desktopPackageInfo}=require('./desktop-package.cjs')
+describe('platform package metadata',()=>{
+  it.each(['darwin','win32','linux'])('%s uses builder identity and ASCII download names',platform=>{
+    const actual=desktopPackageInfo(pkg,platform)
+    const {AppInfo}=require('app-builder-lib/out/appInfo.js')
+    const section={darwin:'mac',win32:'win',linux:'linux'}[platform]
+    const builder=new AppInfo({metadata:pkg,config:pkg.build},undefined,pkg.build[section])
+    expect(actual.displayName).toBe(builder.productName)
+    expect(actual.executableName).toBe(builder.productFilename+(platform==='win32'?'.exe':''))
+    expect(actual.artifacts.every(name=>/^Ddirori-Studio-0\.1\.0-alpha\.38-[\x20-\x7E]+$/.test(name))).toBe(true)
+    if(platform==='darwin')expect(actual.bundleName).toBe('띠로리 Studio.app')
+  })
+})
+it('keeps the mac helper lookup name byte-identical to the builder NFD filename',()=>{
+ const {AppInfo}=require('app-builder-lib/out/appInfo.js')
+ const builder=new AppInfo({metadata:pkg,config:pkg.build},undefined,pkg.build.mac,true)
+ expect(pkg.build.mac.extendInfo.CFBundleName).toBe(builder.productFilename)
+ expect(pkg.build.mac.extendInfo.CFBundleName.normalize('NFC')).toBe(pkg.productName)
+})
diff --git a/scripts/desktop-package.cjs b/scripts/desktop-package.cjs
new file mode 100644
index 00000000..d9526649
--- /dev/null
+++ b/scripts/desktop-package.cjs
@@ -0,0 +1,16 @@
+// Resolve names from the same metadata used by electron-builder. Do not use
+// display branding as an application ID, storage path or project format.
+function desktopPackageInfo(pkg, platform) {
+  const options = pkg.build[{ darwin: 'mac', win32: 'win', linux: 'linux' }[platform]]
+  if (!options) throw new Error(`Unsupported package platform: ${platform}`)
+  const displayName = pkg.build.productName || pkg.productName || pkg.name
+  const executable = options.executableName || pkg.build.executableName || displayName
+  const expand = (template, os, arch, ext) => template.replace(/\$\{(productName|name|version|os|arch|ext)\}/g,
+    (_, key) => ({ productName: displayName, name: pkg.name, version: pkg.version, os, arch, ext })[key])
+  const standard = options.artifactName || pkg.build.artifactName
+  const artifacts = platform === 'darwin' ? ['dmg','zip'].map(ext=>expand(standard,'mac','universal',ext))
+    : platform === 'win32' ? [expand(pkg.build.nsis.artifactName,'windows','x64','exe'),expand(pkg.build.portable.artifactName,'windows','x64','exe')]
+    : [expand(standard,'linux','x86_64','AppImage')]
+  return { displayName, bundleName: `${executable}.app`, executableName: executable + (platform==='win32'?'.exe':''), artifacts }
+}
+module.exports = { desktopPackageInfo }
