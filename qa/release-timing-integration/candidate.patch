diff --git a/qa/macos-release-timing/case-timings.mjs b/qa/macos-release-timing/case-timings.mjs
new file mode 100644
index 000000000..246b518e4
--- /dev/null
+++ b/qa/macos-release-timing/case-timings.mjs
@@ -0,0 +1,50 @@
+import { appendFileSync } from 'node:fs'
+
+export default class CaseTimings {
+  output = process.env.STUDIO_CI_CASE_FILE
+
+  record(entry) {
+    if (!this.output) return
+    try {
+      appendFileSync(this.output, JSON.stringify(entry) + '\n')
+    } catch (error) {
+      this.output = undefined
+      process.stderr.write('::warning::Could not record Vitest case timing: ' + String(error) + '\n')
+    }
+  }
+
+  onTestModuleStart(module) {
+    this.record({ kind: 'module-start', project: module.project.name, file: module.relativeModuleId })
+  }
+
+  onTestCaseResult(test) {
+    const result = test.result()
+    const diagnostic = test.diagnostic()
+    this.record({
+      kind: 'case-result',
+      project: test.module.project.name,
+      file: test.module.relativeModuleId,
+      name: test.fullName,
+      state: result.state,
+      startedAt: diagnostic?.startTime ?? null,
+      durationMs: diagnostic?.duration ?? null,
+      ...(result.errors?.length && { error: result.errors[0].message }),
+    })
+  }
+
+  onTestModuleEnd(module) {
+    const diagnostic = module.diagnostic()
+    this.record({
+      kind: 'module-result',
+      project: module.project.name,
+      file: module.relativeModuleId,
+      state: module.state(),
+      durationMs: diagnostic.duration,
+      collectDurationMs: diagnostic.collectDuration,
+    })
+  }
+
+  onTestRunEnd(_, errors, reason) {
+    this.record({ kind: 'run-end', reason, unhandledErrors: errors.length })
+  }
+}
diff --git a/qa/macos-release-timing/run-release-timing.sh b/qa/macos-release-timing/run-release-timing.sh
new file mode 100644
index 000000000..22dcfcbb6
--- /dev/null
+++ b/qa/macos-release-timing/run-release-timing.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+mode=trace
+test_scope="$1"
+source_dir="$(git rev-parse --show-toplevel)"
+qa_dir="$(cd "$(dirname "$0")" && pwd)"
+source_sha="$(git -C "$source_dir" rev-parse HEAD)"
+qa_sha="$source_sha"
+args=(test -- --maxWorkers=1 --silent=passed-only)
+case "$test_scope" in
+  shard) args+=(--shard=1/4) ;;
+  focused) args+=(src/renderer/src/App.notation-exchange.test.tsx -t studio.metadata-save-feedback) ;;
+  *) exit 2 ;;
+esac
+
+warn() {
+  printf '::warning::%s\n' "$1" >&2
+}
+
+cd "$source_dir"
+if ! mkdir -p "$2" || ! evidence_dir="$(cd "$2" && pwd)" ||
+   ! existing="$(ls -A "$evidence_dir")" || [[ -n "$existing" ]]; then
+  warn 'Could not initialize the Studio timing directory. Running Vitest with standard output.'
+  unset STUDIO_CI_PHASE_FILE STUDIO_CI_CASE_FILE
+  exec npm "${args[@]}"
+fi
+export STUDIO_CI_PHASE_FILE="$evidence_dir/phases.jsonl"
+export STUDIO_CI_CASE_FILE="$evidence_dir/cases.jsonl"
+if ! touch "$STUDIO_CI_PHASE_FILE" "$STUDIO_CI_CASE_FILE"; then
+  warn 'Could not initialize the Studio timing files. Running Vitest with standard output.'
+  unset STUDIO_CI_PHASE_FILE STUDIO_CI_CASE_FILE
+  exec npm "${args[@]}"
+fi
+args+=(--reporter=default "--reporter=$qa_dir/case-timings.mjs")
+
+if ! node --input-type=module - "$evidence_dir" "$mode" "$test_scope" "$source_sha" "$qa_sha" "${args[@]}" <<'JS'
+import { writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { execFileSync } from 'node:child_process'
+const [output, mode, scope, sourceSha, qaSha, ...args] = process.argv.slice(2)
+const info = {
+  mode, scope, sourceSha, qaSha,
+  command: ['npm', ...args],
+  node: process.version, architecture: process.arch, os: process.platform,
+  macOS: process.platform === 'darwin' ? execFileSync('sw_vers', ['-productVersion'], { encoding:'utf8' }).trim() : null,
+  runnerImage: process.env.ImageOS ?? null, runnerImageVersion: process.env.ImageVersion ?? null,
+  gitHubRun: process.env.GITHUB_RUN_ID ?? null,
+  startedAt: new Date().toISOString(),
+}
+writeFileSync(join(output, 'run.json'), JSON.stringify(info, null, 2) + '\n')
+console.log('Studio test timing setup', JSON.stringify(info))
+JS
+then
+  warn 'Could not save the Studio timing run metadata'
+fi
+
+set +e
+(cd "$source_dir" && npm "${args[@]}") 2>&1 | tee "$evidence_dir/vitest.log"
+pipeline=("${PIPESTATUS[@]}")
+set -e
+test_exit="${pipeline[0]}"
+printf 'Vitest exit code: %s\n' "$test_exit"
+if ! printf '%s\n' "$test_exit" > "$evidence_dir/test-exit.txt"; then
+  warn 'Could not save the Vitest exit code'
+fi
+if [[ "${pipeline[1]}" != 0 ]]; then
+  warn 'Could not save the Vitest log'
+fi
+if ! node "$qa_dir/summarize.mjs" "$evidence_dir"; then
+  warn 'Could not summarize the Vitest timing evidence'
+fi
+exit "$test_exit"
diff --git a/qa/macos-release-timing/summarize.mjs b/qa/macos-release-timing/summarize.mjs
new file mode 100644
index 000000000..bd4c067f8
--- /dev/null
+++ b/qa/macos-release-timing/summarize.mjs
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict'
+import { readFileSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+const directory = process.argv[2]
+const original = JSON.parse(readFileSync(join(directory, 'run.json'), 'utf8'))
+const exitCode = Number(readFileSync(join(directory, 'test-exit.txt'), 'utf8').trim())
+const readRows = name => readFileSync(join(directory, name), 'utf8')
+  .split('\n').filter(Boolean).map(line => JSON.parse(line))
+const chronology = readRows('cases.jsonl')
+const phases = readRows('phases.jsonl')
+const caseResults = chronology.filter(row => row.kind === 'case-result')
+const moduleResults = chronology.filter(row => row.kind === 'module-result')
+const runEnd = chronology.findLast(row => row.kind === 'run-end')
+assert(runEnd && caseResults.length > 0)
+assert.equal(exitCode === 0, runEnd.reason === 'passed')
+const targetCases = caseResults.map((result, index) => ({ result, index }))
+  .filter(({ result }) => result.name.includes('studio.metadata-save-feedback')
+    || result.name.includes('records the last phase of an intentional 15-second timeout'))
+const tracked = targetCases.map(({ result, index }) => {
+  const channel = original.mode === 'timeout' ? 'intentional-timeout'
+    : result.name.includes('blocked save') ? 'save' : 'copy'
+  const checkpoints = phases.filter(row => row.channel === channel)
+  const predecessorCases = caseResults.slice(0, index)
+    .filter(row => Number.isFinite(row.durationMs)).slice(-3)
+  assert(checkpoints.every((row, position) => Number.isFinite(row.ms)
+    && (position === 0 || row.ms >= checkpoints[position - 1].ms)))
+  return { channel, ...result, checkpoints, lastCompletedPhase: checkpoints.at(-1) ?? null, predecessorCases }
+})
+assert.equal(tracked.length, original.mode === 'timeout' ? 1 : 2)
+if (original.mode === 'timeout') {
+  const [probe] = tracked
+  assert.equal(exitCode, 1)
+  assert.match(probe.error, /timed out in 15000ms/i)
+  assert.equal(probe.lastCompletedPhase?.name, 'awaiting synthetic timeout')
+  assert.equal(probe.predecessorCases.at(-1)?.state, 'passed')
+}
+if (original.mode === 'trace' && exitCode === 0) {
+  assert(tracked.every(entry => entry.lastCompletedPhase?.name === 'complete'))
+}
+const summary = {
+  ...original, exitCode, reason: runEnd.reason,
+  totals: {
+    modules: moduleResults.length,
+    passed: caseResults.filter(row => row.state === 'passed').length,
+    failed: caseResults.filter(row => row.state === 'failed').length,
+    skipped: caseResults.filter(row => row.state === 'skipped').length,
+  },
+  tracked,
+}
+writeFileSync(join(directory, 'summary.json'), JSON.stringify(summary, null, 2) + '\n')
+console.log('Studio test timing receipt', JSON.stringify(summary))
